CC = cc
CFLAGS = -Wall -Wextra -Werror -g -fsanitize=address
NAME = cub3D
MLX = MLX42/build/libmlx42.a
SRC = main.c \
      parsing/parsing.c \
      parsing/get_next_line.c \
      parsing/utils.c \
      parsing/map.c \
      parsing/path.c \
      parsing/tools.c \
      parsing/clean_memory.c \
      parsing/read_from_file.c \
      parsing/colors.c \
      raycasting/raycasting.c \
      raycasting/texture_loading.c \
      raycasting/texture.c \
      raycasting/rotation.c \
      raycasting/ray_init.c \
      raycasting/movement.c \
      raycasting/map_utils.c \
      libft/ft_atoi.c \
      libft/ft_lstsize.c \
      libft/ft_lstadd_back.c \
      libft/ft_split.c \
      libft/ft_strchr.c \
      libft/ft_strdup.c \
      libft/ft_strjoin.c \
      libft/ft_strlen.c \
      libft/ft_strncmp.c \
      libft/ft_strtrim.c \
      libft/ft_substr.c
OBJ = $(SRC:.c=.o)
all: $(NAME)
$(MLX):
	@test -d MLX42 || git clone https://github.com/codam-coding-college/MLX42.git
	@cmake MLX42 -B MLX42/build
	@make -C MLX42/build -j4
$(NAME): $(MLX) $(OBJ)
	$(CC) $(CFLAGS) $(OBJ) $(MLX) -IMLX42/include -L/goinfre/$(USER)/homebrew/opt/glfw/lib -lglfw -framework Cocoa -framework OpenGL -framework IOKit -o $(NAME)
%.o: %.c cub3d.h
	$(CC) $(CFLAGS) -IMLX42/include -c $< -o $@
clean:
	rm -rf $(OBJ)
fclean: clean
	rm -rf $(NAME)
mlxclean: fclean
	rm -rf MLX42
re: fclean all
.PHONY: all clean fclean re mlxclean